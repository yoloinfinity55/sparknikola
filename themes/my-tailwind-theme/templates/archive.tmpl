## archive.tmpl
<%inherit file="base.tmpl"/>

<%block name="content">
<div class="prose max-w-none">
    <h1>Archive</h1>
    % for post in posts:
        <article class="mb-8 border-b pb-4">
            <h2 class="text-2xl font-semibold">
                <a href="${post.permalink()}" class="text-primary hover:text-primary/80">${post.title()}</a>
            </h2>
            <time class="text-gray-500">${post.formatted_date(date_format)}</time>
            <p class="mt-2">${post.text(teaser_only=True, strip_html=True)[:150]}...</p>
        </article>
    % endfor
</div>
</%block>