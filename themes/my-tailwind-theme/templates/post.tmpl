<%include file="base_header.tmpl" />

<div class="prose max-w-none">
    <article>
        <header class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">${post.title()}</h1>
            <div class="flex items-center text-gray-600 text-sm">
                <time datetime="${post.date.isoformat()}">${post.formatted_date(date_format)}</time>
                % if post.tags:
                <span class="mx-2">•</span>
                <div class="flex flex-wrap gap-2">
                    % for tag in post.tags:
                    <span class="inline-block bg-gray-100 text-gray-800 px-2 py-1 rounded text-xs">${tag}</span>
                    % endfor
                </div>
                % endif
            </div>
        </header>

        <div class="prose-content">
            ${post.text()}
        </div>

        % if post.prev_post or post.next_post:
        <nav class="mt-12 pt-8 border-t border-gray-200">
            <div class="flex justify-between">
                % if post.prev_post:
                <a href="${post.prev_post.permalink()}" class="text-primary hover:underline">
                    ← ${post.prev_post.title()}
                </a>
                % endif
                % if post.next_post:
                <a href="${post.next_post.permalink()}" class="text-primary hover:underline ml-auto">
                    ${post.next_post.title()} →
                </a>
                % endif
            </div>
        </nav>
        % endif
    </article>
</div>

<%include file="base_footer.tmpl" />
