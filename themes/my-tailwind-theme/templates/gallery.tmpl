<%include file="base_header.tmpl" />
<div class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Galleries</h1>
    % if galleries:
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        % for gallery in galleries:
            <article class="bg-white rounded-lg shadow-md overflow-hidden">
                <img src="${gallery.thumbnail_url()}" alt="${gallery.title()}" class="w-full h-48 object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold mb-2"><a href="${gallery.permalink()}" class="text-primary hover:text-primary/80">${gallery.title()}</a></h2>
                    <p class="text-gray-600">${gallery.description()[:100]}...</p>
                </div>
            </article>
        % endfor
        </div>
    % else:
        <p class="text-gray-500">No galleries yet. Add images to <code>galleries/</code> to get started!</p>
    % endif
</div>
<%include file="base_footer.tmpl" />